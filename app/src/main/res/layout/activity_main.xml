<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atlan_bg">

    <!-- LAYAR UTAMA: BERSIH KHUSUS CHAT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/atlan_bg">

        <!-- Header: hamburger + ATLAN gradient + pill status -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:background="@color/atlan_panel"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="&#9776;"
                android:textColor="@color/atlan_text"
                android:textSize="20sp"
                app:backgroundTint="@color/atlan_panel2"
                app:cornerRadius="12dp"
                app:strokeColor="@color/atlan_border"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:text="ATLAN"
                android:textColor="@color/atlan_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnMenu"
                app:layout_constraintEnd_toStartOf="@id/tvPill" />

            <TextView
                android:id="@+id/tvPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_bg"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Belum dimuat"
                android:textColor="@color/atlan_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Area percakapan di tengah -->
        <ScrollView
            android:id="@+id/scrollChat"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/inputBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chatCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/atlan_panel"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/atlan_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/chatListCtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp" />
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>

        <!-- Input bar di bagian bawah -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/inputBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/atlan_bg"
            android:padding="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/composer_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:paddingStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/etPrompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Tulis pertanyaan di sini..."
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minHeight="46dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/atlan_text"
                    android:textColorHint="@color/atlan_muted"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerate"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="9dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    android:text="&#8593;"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    app:backgroundTint="@color/atlan_violet2"
                    app:cornerRadius="25dp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PANEL PENGATURAN SAMPING KIRI (TERBUKA DARI GARIS TIGA) -->
    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/atlan_drawer"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/navDrawerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/atlan_drawer"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDrawerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATLAN"
            android:textColor="@color/atlan_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tvDrawerVer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="v1.1"
            android:textColor="@color/atlan_muted"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewChat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="+ CHAT BARU"
            android:textColor="@color/atlan_text"
            android:textSize="12sp"
            app:backgroundTint="@color/atlan_panel2"
            app:cornerRadius="24dp"
            app:strokeColor="@color/atlan_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/atlan_panel"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/atlan_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MODEL AKTIF"
                    android:textColor="@color/atlan_violet"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Status: model belum di-load"
                    android:textColor="@color/atlan_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSelectedModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="File: belum dipilih"
                    android:textColor="@color/atlan_text2"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickFile"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="PILIH FILE (.GGUF)"
                    android:textColor="@color/atlan_text2"
                    android:textSize="12sp"
                    app:backgroundTint="@color/atlan_panel2"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/atlan_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoadModel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="LOAD MODEL"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:backgroundTint="@color/atlan_violet2"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LORA ADAPTERS"
            android:textColor="@color/atlan_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:id="@+id/tvLoraInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="LoRA: 0 terpasang"
            android:textColor="@color/atlan_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/loraListCtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddLora"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="TAMBAH LORA"
            android:textColor="@color/atlan_text2"
            android:textSize="12sp"
            app:backgroundTint="@color/atlan_panel2"
            app:cornerRadius="12dp"
            app:strokeColor="@color/atlan_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLora"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="HAPUS SEMUA LORA"
            android:textColor="@color/atlan_red"
            android:textSize="12sp"
            app:backgroundTint="@color/atlan_panel2"
            app:cornerRadius="12dp"
            app:strokeColor="@color/atlan_red"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/atlan_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PUSTAKA"
            android:textColor="@color/atlan_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:id="@+id/tvModeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mode: Ketat (hanya dari buku)"
            android:textColor="@color/atlan_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeToggle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="UBAH KE BEBAS"
            android:textColor="@color/atlan_text2"
            android:textSize="12sp"
            app:backgroundTint="@color/atlan_panel2"
            app:cornerRadius="12dp"
            app:strokeColor="@color/atlan_border"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/tvBookInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Buku: 0 aktif"
            android:textColor="@color/atlan_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/bookListCtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddBook"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="TAMBAH BUKU (TXT)"
            android:textColor="@color/atlan_text2"
            android:textSize="12sp"
            app:backgroundTint="@color/atlan_panel2"
            app:cornerRadius="12dp"
            app:strokeColor="@color/atlan_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearBooks"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="HAPUS SEMUA BUKU"
            android:textColor="@color/atlan_red"
            android:textSize="12sp"
            app:backgroundTint="@color/atlan_panel2"
            app:cornerRadius="12dp"
            app:strokeColor="@color/atlan_red"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/atlan_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERCAKAPAN"
            android:textColor="@color/atlan_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:id="@+id/tvHistoryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Riwayat disimpan: 0 / 20"
            android:textColor="@color/atlan_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/convListCtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="HAPUS RIWAYAT"
            android:textColor="@color/atlan_red"
            android:textSize="12sp"
            app:backgroundTint="@color/atlan_panel2"
            app:cornerRadius="12dp"
            app:strokeColor="@color/atlan_red"
            app:strokeWidth="1dp" />

    </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
