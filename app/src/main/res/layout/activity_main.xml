<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1117">

    <!-- LAYAR UTAMA: BERSIH KHUSUS CHAT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0E1117">

        <!-- Header minimalis: tombol garis tiga di kiri atas + judul -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="#161B22"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="MENU"
                android:textColor="#F0F6FC"
                android:textSize="18sp"
                app:backgroundTint="#21262D"
                app:cornerRadius="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Atlan"
                android:textColor="#F0F6FC"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnMenu"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Area percakapan di tengah -->
        <ScrollView
            android:id="@+id/scrollChat"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/inputBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#161B22"
                app:cardCornerRadius="16dp"
                app:strokeColor="#30363D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Percakapan"
                        android:textColor="#A371F7"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="5dp"
                        android:text="Belum ada percakapan. Buka menu di kiri atas untuk memilih dan me-load model."
                        android:textColor="#E6EDF3"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>

        <!-- Input bar di bagian bawah -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/inputBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#161B22"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/etPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="#0E1117"
                android:hint="Tulis pertanyaan di sini..."
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minHeight="46dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="#F0F6FC"
                android:textColorHint="#8B949E"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnGenerate" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="KIRIM"
                android:textColor="#FFFFFF"
                app:backgroundTint="#8957E5"
                app:cornerRadius="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PANEL PENGATURAN SAMPING KIRI (TERBUKA DARI GARIS TIGA) -->
    <ScrollView
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#161B22"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/navDrawerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan &amp; Model"
            android:textColor="#F0F6FC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: model belum di-load"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSelectedModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="File: belum dipilih"
            android:textColor="#C9D1D9"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickFile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:text="PILIH FILE (.GGUF)"
            android:textColor="#E6EDF3"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoadModel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="LOAD MODEL"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:backgroundTint="#6E40C9"
            app:cornerRadius="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#30363D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LoRA Adapters"
            android:textColor="#F0F6FC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoraInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="LoRA: 0 terpasang"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/loraListCtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddLora"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="TAMBAH LORA"
            android:textColor="#E6EDF3"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLora"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="HAPUS SEMUA LORA"
            android:textColor="#F85149"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#F85149"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#30363D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pustaka"
            android:textColor="#F0F6FC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvModeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mode: Ketat (hanya dari buku)"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeToggle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="UBAH KE BEBAS"
            android:textColor="#E6EDF3"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/tvBookInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Buku: 0 aktif"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/bookListCtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddBook"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="TAMBAH BUKU (TXT)"
            android:textColor="#E6EDF3"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearBooks"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="HAPUS SEMUA BUKU"
            android:textColor="#F85149"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#F85149"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#30363D" />

        <TextView
            android:id="@+id/tvHistoryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Riwayat disimpan: 0 / 20 pesan"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="HAPUS RIWAYAT"
            android:textColor="#F85149"
            android:textSize="12sp"
            app:backgroundTint="#21262D"
            app:cornerRadius="12dp"
            app:strokeColor="#F85149"
            app:strokeWidth="1dp" />

    </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
